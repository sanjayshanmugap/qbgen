{
  "name": "qbgen-app",
  "version": "1.0.0",
  "description": "Quiz Bowl Question Generator - Next.js frontend with Flask backend",
  "private": true,
  "workspaces": [
    "qbgen-landing"
  ],
  "scripts": {
    "build": "cd qbgen-landing && pnpm build",
    "dev": "cd qbgen-landing && pnpm dev",
    "start": "cd qbgen-landing && pnpm start",
    "docker:build": "docker build -t qbgen-app:latest .",
    "docker:run": "docker run -p 8080:8080 qbgen-app:latest"
  },
  "keywords": [
    "quiz-bowl",
    "nextjs",
    "flask",
    "python",
    "docker"
  ],
  "author": "Sanjay",
  "license": "MIT"
}
